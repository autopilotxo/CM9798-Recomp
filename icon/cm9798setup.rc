/* Windows resources for cm9798setup: its icon and the details shown under the .exe's Properties > Details */
1 ICON "cm9798setup.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3F
FILEFLAGS       0x0
FILEOS          0x40004      /* VOS_NT_WINDOWS32 */
FILETYPE        0x1          /* VFT_APP */
FILESUBTYPE     0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904B0"     /* English (UK), Unicode */
        BEGIN
            VALUE "CompanyName",      "CM9798 Recomp Project"
            VALUE "FileDescription",  "Championship Manager 97/98 Recomp - Setup"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "cm9798setup"
            VALUE "OriginalFilename", "cm9798setup.exe"
            VALUE "ProductName",      "Championship Manager 97/98 Recomp"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Unofficial fan port. Requires the original game (CM2E16.EXE v2.93), which is not included. Championship Manager is a trademark of its owners."
            VALUE "Comments",         "Sets up a folder for the port from your own copy of the game, and imports the CM2 and CM 96/97 databases."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
